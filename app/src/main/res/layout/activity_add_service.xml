<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">


    <View
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#4CAF50"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/titleAddService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register your service"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"/>


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <EditText
                android:id="@+id/etNameSurname"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Service/Company name"
                android:background="#FFFFFF"
                android:padding="15dp"
                android:layout_marginBottom="15dp"/>


            <EditText
                android:id="@+id/etCompanyName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Owner name (optional)"
                android:background="#FFFFFF"
                android:padding="15dp"
                android:layout_marginBottom="15dp"/>


            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Address"
                android:background="#FFFFFF"
                android:padding="15dp"
                android:layout_marginBottom="15dp"/>
            <Button
                android:id="@+id/btnChooseOnMap"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="15dp"
                android:text="Choose on map"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">


                <com.hbb20.CountryCodePicker
                    android:id="@+id/ccpService"
                    android:layout_marginTop="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:ccp_showFullName="false"
                    app:ccp_defaultNameCode="AM"
                    app:ccp_autoDetectCountry="true"/>


                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Phone number"
                    android:inputType="phone"
                    android:background="#FFFFFF"
                    android:padding="15dp"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>


            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Description"
                android:gravity="top"
                android:background="#FFFFFF"
                android:padding="15dp"
                android:layout_marginBottom="20dp"/>


            <ImageView
                android:id="@+id/imgServicePhoto"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#DDDDDD"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                android:layout_marginBottom="15dp"/>


            <Button
                android:id="@+id/btnUploadPhoto"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="15dp"
                android:backgroundTint="#4CAF50"
                android:text="Attach Photo"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnConfirmService"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Confirm"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>