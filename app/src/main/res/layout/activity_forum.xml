<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/forum_background">

    <!-- MAIN VERTICAL SCREEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#4CAF50"
            android:text="Forum's"
            android:textColor="#FFFFFF"
            android:textSize="35sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- CONTENT GRID -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:columnCount="2"
            android:rowCount="2">

            <!-- MAIN -->
            <LinearLayout
                android:id="@+id/btnMain"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:background="@drawable/forum_card_ripple"
                android:gravity="center">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/ic_main"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Main"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- SERVICES -->
            <LinearLayout
                android:id="@+id/btnServicesForum"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:background="@drawable/forum_card_ripple"
                android:gravity="center">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/ic_services"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Services"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- VETERINARIANS -->
            <LinearLayout
                android:id="@+id/btnVeterinariansForum"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:background="@drawable/forum_card_ripple"
                android:gravity="center">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/ic_vet"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Veterinarians"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- SHOPS -->
            <LinearLayout
                android:id="@+id/btnShopsForum"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:background="@drawable/forum_card_ripple"
                android:gravity="center">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/ic_shop"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shops"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

        </GridLayout>

        <!-- BOTTOM MENU -->
        <LinearLayout
            android:id="@+id/bottomMenu"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#4CAF50"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="20dp">

            <!-- ANNOUNCEMENTS -->
            <LinearLayout
                android:id="@+id/btnAnnouncements"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_services"
                    app:tint="#FFFFFF" />

                <TextView
                    android:text="Announcements"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- PROFILE -->
            <LinearLayout
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_main"
                    app:tint="#FFFFFF" />

                <TextView
                    android:text="My Profile"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- FORUM -->
            <LinearLayout
                android:id="@+id/btnForum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_forum"
                    app:tint="#FFFFFF" />

                <TextView
                    android:text="Forum"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- DROPDOWN MENU (FIXED OVERLAY) -->
    <LinearLayout
        android:id="@+id/dropdownMenu"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_settings_popup"
        android:elevation="30dp"
        android:padding="10dp"

        android:layout_gravity="bottom|start"
        android:layout_marginBottom="100dp">

        <Button
            android:id="@+id/btnServicesOption"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="Services"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnShops"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="Shops"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnVeterinarians"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="Veterinarians"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50" />

    </LinearLayout>

</FrameLayout>