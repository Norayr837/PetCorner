<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- IMAGE -->
            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerCrop"/>

            <!-- MAIN CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_margin="10dp"
                android:padding="12dp">

                <!-- NAME + OWNER -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/detailName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/detailOwnerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#777"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <!-- ADDRESS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#F2F2F2">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_map_pin"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/detailAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#333"/>

                    <ImageButton
                        android:id="@+id/btnCopyAddress"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:color/transparent"
                        android:src="@android:drawable/ic_menu_share"/>
                </LinearLayout>

                <!-- PHONE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:padding="8dp"
                    android:background="#F2F2F2">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_call"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/detailPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#555"/>

                    <ImageButton
                        android:id="@+id/btnCopyPhone"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:color/transparent"
                        android:src="@android:drawable/ic_menu_share"/>
                </LinearLayout>

                <!-- DESCRIPTION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/detailDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#666"/>
                </LinearLayout>

                <!-- RATING -->
                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="0.5"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_margin="10dp"
                android:visibility="gone"
                android:padding="12dp">

                <EditText
                    android:id="@+id/etReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Write review"
                    android:background="@drawable/bg_edittext"
                    android:padding="10dp"/>

                <Button
                    android:id="@+id/btnSendReview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#fff"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="10dp">

                <!-- кнопка меню (⋮) -->
                <ImageButton
                    android:id="@+id/btnMoreOptions"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:visibility="gone"
                    android:src="@android:drawable/ic_menu_more"
                    android:background="@android:color/transparent"/>

                <!-- скрытое меню -->
                <LinearLayout
                    android:id="@+id/optionsMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnEditShop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Service"
                        android:backgroundTint="#FF9800"
                        android:textColor="#fff"
                        android:visibility="gone"/>

                    <Button
                        android:id="@+id/btnDeleteShop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete Service"
                        android:backgroundTint="#F44336"
                        android:textColor="#fff"
                        android:visibility="gone"
                        android:layout_marginStart="10dp"/>

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnSendMessageShop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send Message"
                android:backgroundTint="#4CAF50"
                android:textColor="#fff"
                android:visibility="gone"
                android:layout_marginStart="10dp"/>

            <!-- REVIEWS LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"/>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="#4CAF50"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnServices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/circle_button"
            android:orientation="vertical">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_services"
                app:tint="#FFFFFF"/>

            <TextView
                android:text="Announcements"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/circle_button"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_main"
                app:tint="#FFFFFF"/>

            <TextView
                android:text="My Profile"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnForum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/circle_button"
            android:orientation="vertical">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_forum"
                app:tint="#FFFFFF"/>

            <TextView
                android:text="Forum"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 📦 DROPDOWN -->
    <LinearLayout
        android:id="@+id/dropdownMenu"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_settings_popup"
        android:elevation="12dp"
        android:padding="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomMenu"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnServicesOption"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="Services"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnShops"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="Shops"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnVeterinarians"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="Veterinarians"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>